FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
WORKDIR /app
# Install dependencies, including mysqlclient (needed for the database)
COPY requirements.txt /app/
RUN apt-get update && apt-get install -y \
    # 1. Install the C compiler and tools
    build-essential \ 
    # 2. Install MySQL client libraries (which you already had)
    default-libmysqlclient-dev \
    pkg-config \
    # 3. Necessary for cryptographic dependencies sometimes
    libssl-dev \
    # Install Python dependencies
    && pip install --no-cache-dir -r requirements.txt \
    # Clean up the package manager cache to reduce final image size
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY . /app/
EXPOSE 8000
